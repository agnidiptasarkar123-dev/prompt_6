# -----------------------------------------------------------------------------
# HawaSaathi Environment Configuration Template (.env.example)
# SPDX-License-Identifier: Apache-2.0
# -----------------------------------------------------------------------------

# Next.js Server Runtime
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# 1. Environmental Data Providers (Server-Side Only)
# -----------------------------------------------------------------------------

# Central Pollution Control Board (CPCB) via National Data Portal (data.gov.in)
DATA_GOV_IN_API_KEY=your_datagov_in_api_key_here

# OpenAQ API v3 Key
OPENAQ_API_KEY=your_openaq_v3_api_key_here

# Open-Meteo Air Quality (Optional commercial key; defaults to free public tier)
OPEN_METEO_API_KEY=

# -----------------------------------------------------------------------------
# 2. AI Intelligence (Google Gemini - Server-Side Only)
# -----------------------------------------------------------------------------

# Google GenAI API Key for Gemini 2.5 Flash contextual advice synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 3. Distributed Cache & Rate Limiting (Upstash Redis)
# -----------------------------------------------------------------------------

# Optional: If unconfigured, automatically falls back to in-memory cache/rate limiter
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# 4. Firebase Authentication & Firestore (Server-Side Admin SDK)
# -----------------------------------------------------------------------------

FIREBASE_PROJECT_ID=hawasaathi-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@hawasaathi-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# 5. Firebase Client Configuration (Browser / Public Runtime)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA_sample_public_client_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hawasaathi-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hawasaathi-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hawasaathi-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:sampleappid
