rules_version = '2';

/**
 * HawaSaathi Cloud Firestore Security Rules
 * Baseline: OWASP ASVS 5.0.0 Level 2
 * Authoritative Pattern: Next.js Backend-for-Frontend (BFF) with Firebase Admin SDK
 * 
 * Direct Client Access Policy: Default Deny All.
 * All reads, writes, profile mutations, and privacy operations are strictly mediated
 * by Next.js server API routes where the Firebase Admin SDK verifies ID tokens and
 * enforces UID tenant ownership in code.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All: Direct client SDK reads and writes are completely blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
